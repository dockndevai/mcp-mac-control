# mcp-mac-control is FULL CONTROL BY DEFAULT. With no config it runs in admin mode with command
# execution, deletes, and GUI input all enabled. Everything below only RESTRICTS it.

# --- Master switch ----------------------------------------------------------
# Flip the whole server to safe-by-default: read-only, all powers gated, confirmations on.
MACCTL_SAFE_MODE=false

# --- Access model -----------------------------------------------------------
# read-only | read-write | admin. Defaults to admin (read-only when SAFE_MODE=true).
MACCTL_MODE=admin
# Individual powers (all default true in full control, false in safe mode):
MACCTL_ALLOW_EXEC=true      # run_command / run_applescript / kill_process
MACCTL_ALLOW_DELETE=true    # delete_path (moves to Trash)
MACCTL_ALLOW_INPUT=true     # GUI input: click / type / key / drag / scroll (needs Accessibility)
# Require a human to approve destructive ops via MCP elicitation (default off in full control):
MACCTL_CONFIRM=false

# --- Scoping (optional) -----------------------------------------------------
# Comma-separated path roots the agent may touch (empty = anywhere). Supports ~.
MACCTL_PATH_ALLOWLIST=
# Comma-separated roots readable but never modified/deleted (empty by default here; e.g.
# /System,/Library,~/.ssh,~/.aws,~/Library/Keychains).
MACCTL_PROTECTED_PATHS=
# Restrict run_command to these program names (empty = any).
MACCTL_COMMAND_ALLOWLIST=

# --- Preview / audit --------------------------------------------------------
# Validate + log writes without executing them.
MACCTL_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
MACCTL_AUDIT_LOG=true

# --- Limits -----------------------------------------------------------------
MACCTL_MAX_FILE_BYTES=1000000
MACCTL_MAX_OUTPUT_BYTES=100000
MACCTL_COMMAND_TIMEOUT_MS=30000
